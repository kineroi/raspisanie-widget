{
  "name": "raspisanie-desktop",
  "version": "3.0.0",
  "description": "Моё расписание — уроки, домашка и BilimClass на компьютере",
  "author": "kineroi",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/logic.test.js test/grades.test.js test/ai.test.js test/analysis.test.js test/attestation.test.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "kz.nikolaevka.raspisanie",
    "productName": "Моё расписание",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "raspisanie-setup.exe",
      "shortcutName": "Моё расписание",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kineroi",
        "repo": "raspisanie-widget",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2"
  }
}
